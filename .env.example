# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security (REQUIRED in production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Request Limits
MAX_CONTENT_LENGTH=1048576
MAX_TASK_LENGTH=10240
MAX_CONTEXT_LENGTH=51200
MAX_FIELD_LENGTH=51200
MAX_TONE_LENGTH=256

# Monitoring
METRICS_ENABLED=true

# CORS
CORS_ORIGINS=*

# Gunicorn (if using gunicorn directly)
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./prompt_generator.db

# Encryption for API keys
ENCRYPTION_KEY=change-me-in-production
